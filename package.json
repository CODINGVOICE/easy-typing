{
  "name": "pinyin-typing-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "generate:gb2312": "node scripts/generate-gb2312.mjs",
    "generate:grades": "node scripts/generate-grade-characters.mjs",
    "generate:data": "npm run generate:gb2312 && npm run generate:grades",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop:preview": "npm run build && node scripts/run-electron.mjs",
    "build:desktop": "npm run build && node scripts/build-desktop-all.mjs",
    "build:desktop:dir": "npm run build && node scripts/build-desktop.mjs --dir",
    "build:desktop:mac": "npm run build && node scripts/build-desktop.mjs --mac --arm64",
    "build:desktop:mac:arm64": "npm run build && node scripts/build-desktop.mjs --mac --arm64",
    "build:desktop:mac:x64": "npm run build && node scripts/build-desktop.mjs --mac --x64",
    "build:desktop:mac:all": "npm run build && node scripts/build-desktop-all.mjs --mac-only",
    "build:desktop:win": "npm run build && node scripts/build-desktop.mjs --win --x64"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "pinyin-pro": "^3.28.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.sm2170.pinyintypinggame",
    "productName": "拼音打字乐园",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "artifactName": "${productName}-${version}-${arch}-macos.${ext}",
      "target": [
        "zip"
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "artifactName": "${productName}-${version}-win64.${ext}",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
